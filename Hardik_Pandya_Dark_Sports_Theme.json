{
  "name": "Hardik Pandya Dark Sports Analytics",
  "dataColors": [
    "#00D2FF",
    "#FF6B00",
    "#10B981",
    "#38BDF8",
    "#F59E0B",
    "#8B5CF6",
    "#EC4899",
    "#64748B",
    "#22D3EE",
    "#F97316"
  ],
  "background": "#070B14",
  "foreground": "#F8FAFC",
  "tableAccent": "#00D2FF",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "transparency": 15
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E293B" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight",
            "shadowSpread": 2,
            "shadowBlur": 10,
            "angle": 135,
            "transparency": 50
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "alignment": "Left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#94A3B8" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": { "solid": { "color": "#94A3B8" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#00D2FF" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#94A3B8" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "cardBackground": [
          {
            "color": { "solid": { "color": "#111827" } },
            "transparency": 20
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "cardTitle": [
          {
            "color": { "solid": { "color": "#FF6B00" } },
            "fontSize": 12
          }
        ],
        "dataLabels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 18
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#00D2FF" } },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#E2E8F0" } },
            "background": { "solid": { "color": "#1E293B" } },
            "textSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#00D2FF" } },
            "backColor": { "solid": { "color": "#0B132B" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#F8FAFC" } },
            "backColorPrimary": { "solid": { "color": "#0F172A" } },
            "fontColorSecondary": { "solid": { "color": "#E2E8F0" } },
            "backColorSecondary": { "solid": { "color": "#162032" } },
            "fontSize": 9
          }
        ],
        "totals": [
          {
            "fontColor": { "solid": { "color": "#FF6B00" } },
            "backColor": { "solid": { "color": "#0B132B" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#1E293B" } },
            "gridHorizontalWeight": 1
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "fillPoint": [
          {
            "show": true
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    }
  }
}
